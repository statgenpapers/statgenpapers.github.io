rules_version = '2';
// Publish with `npx firebase deploy --only firestore:rules --project statgenpapers` in firebase/, after `npm test`.
//
// Upvotes: one document per upvote, months/{YYYY-MM}/votes/{paperId}~{handle, lower case}
//   { paper: "<paper id>", handle: "<handle, lower case>" }
// The document existing is the upvote; there are no downvotes. The id fixes one upvote per
// handle and paper. Handles have no password: any signed-in (anonymous) browser may add or
// remove the upvote of any handle, which is the accepted trade-off of password-free handles.
// Upvotes are never edited, only added and removed.
//
// Papers added by visitors: months/{YYYY-MM}/submissions/{id}
//   { journal, title, url, short_name, uid, created, name: "<handle>", and optionally authors: [..], abstract, date }
// A signed-in browser may add a paper under its own uid; nobody can edit one. Like an upvote, any signed-in
// browser may delete a reader's paper: the site offers that to the paper's handle only, until the monthly run
// lists it. Upvotes of an added paper are votes like any other, with the submission id.
//
// The handle "admin" is reserved: its marks and added papers are the cold start (dev/lab_marks.py), written,
// and removed, only by one Firebase user.
//
// Everything else, including the uid-keyed months/{YYYY-MM}/papers of the first version,
// is closed.
service cloud.firestore {
  match /databases/{database}/documents {
    match /months/{month}/votes/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && month.matches('^20[0-9]{2}-(0[1-9]|1[0-2])$')
        && validVote(request.resource.data, id)
        && mayUse(request.resource.data.handle);
      allow delete: if request.auth != null && mayUse(resource.data.handle);
    }
    match /months/{month}/submissions/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && month.matches('^20[0-9]{2}-(0[1-9]|1[0-2])$')
        && id.matches('^[A-Za-z0-9]{1,40}$')
        && validSubmission(request.resource.data)
        && mayUse(request.resource.data.name);
      // like a mark: any signed-in browser (a handle has no password); the site offers it to the paper's handle only
      allow delete: if request.auth != null && mayUse(resource.data.name);
    }
    function mayUse(h) {
      return h != 'admin' || request.auth.uid == 'Yo7cchMxl7X4zHq5vOE9VmS2dOp1';  // the lab's user: ~/.config/statgenpapers/lab.json
    }
    function validHandle(h) {
      return h is string && h.matches('^[a-z0-9_]{2,20}$');
    }
    function validVote(d, id) {
      return d.keys().hasAll(['paper', 'handle']) && d.keys().hasOnly(['paper', 'handle'])
        && d.paper is string && d.paper.matches('^[A-Za-z0-9._-]{1,150}$')
        && validHandle(d.handle)
        && id == d.paper + '~' + d.handle;
    }
    function validSubmission(d) {
      return d.keys().hasAll(['journal', 'title', 'url', 'short_name', 'uid', 'created', 'name'])
        && d.keys().hasOnly(['journal', 'title', 'url', 'short_name', 'uid', 'created', 'name', 'authors', 'abstract', 'date'])
        && (!('authors' in d) || (d.authors is list && d.authors.size() <= 300))
        && (!('abstract' in d) || (d.abstract is string && d.abstract.size() <= 10000))
        && (!('date' in d) || (d.date is string && d.date.matches('^[0-9]{4}(-[0-9]{2}){0,2}$')))
        && d.uid == request.auth.uid
        && d.created == request.time
        && d.journal is string && d.journal.size() >= 1 && d.journal.size() <= 60
        && d.title is string && d.title.size() >= 1 && d.title.size() <= 400
        && d.url is string && d.url.size() <= 500 && d.url.matches('^https?://[^ ]+$')
        && d.short_name is string && d.short_name.size() >= 1 && d.short_name.size() <= 150
        && validHandle(d.name);
    }
  }
}
